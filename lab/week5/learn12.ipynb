   "source": [
    "class parent(object):\n",
    "    def __init__(self):\n",
    "        self.__private_money = 1000\n",
    "        self._protected_money = 500\n",
    "        self.public_money = 100\n",
    "\n",
    "    def __str__(self):\n",
    "        return f\"Paremt has total {self.__private_money + self._protected_money + self.public_money} money\"\n",
    "\n",
    "class Child(parent):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "    def __str__(self):\n",
    "        return f\"Child : {self._protected_money + self.public_money}\"\n",
    "\n",
    "def test():\n",
    "    P = parent()\n",
    "    print(p)\n",
    "    c = Child()\n",
    "    print(c)\n",
    "\n",
    "    print(p.public_money)\n",
    "    print(p._protected_money)\n",
    "    print(p.__prinvate_money)\n",
    "\n",
    "    \n",
    "\n",
    "test()\n"
   ]
