    "class car:\n",
    "    def __init__(self, maker, model, color, price):\n",
    "        self.maker = maker\n",
    "        self.model = model\n",
    "        self.color = color \n",
    "        self.price = price\n",
    "\n",
    "    def setMaker(self, maker):\n",
    "        self.maker = maker\n",
    "\n",
    "    def getMaker(self):\n",
    "        return self.maker\n",
    "\n",
    "    def getDesc(self):\n",
    "        return self.__str__()\n",
    "\n",
    "    def __str__(self):\n",
    "        return f\"Maker: {self.maker}, Model: {self.model}, Color: {self.color}, Price: {self.price}\"\n",
    "    \n",
    "class ElectricCar(car):\n",
    "    def __init__(self, maker, model, color, price, bat_size):\n",
    "        super().__init__(maker, model, color, price)\n",
    "        self.batterySize = bat_size\n",
    "\n",
    "    def getBatterySize(self):\n",
    "        return self.batterySize\n",
    "\n",
    "    def setBatterySize(self, bat_size):\n",
    "        self.batterySize = bat_size\n",
    "    \n",
    "    def __str__(self):\n",
    "        return f\"{super().__str__()}, Battery: {self.batterySize}kwh\"\n",
    "\n",
    "    def getDesc(self):\n",
    "        return self.__str__()\n",
    "\n",
    "class Truck(car):\n",
    "    def __init__(self, maker, model, color, price, playLoad):\n",
    "        super().__init__(maker, model, color, price)\n",
    "        self.playLoad = playLoad\n",
    "\n",
    "    def __str__(self):\n",
    "        return f\"{super().__str__()}, Payload: {self.playLoad}kg\"\n",
    "    \n",
    "car1 = car(\"kia\", \"Ray\", \"Blue\", 2000)\n",
    "print(car1.getDesc())\n",
    "print(car1.model)\n",
    "\n",
    "ecar1 = ElectricCar(\"Tesla\", \"Model S\", \"Red\", 8000, 81)\n",
    "print(ecar1)\n",
    "ecar1.setBatterySize(92)\n",
    "print(ecar1.getDesc())\n",
    "truc1 = Truck(\"Ford\", \"F-150\", \"Black\", 4000, 1000)\n",
    "print(truc1)\n",
    "print(truc1.getMaker())\n",
    "\n",
    "print(type(truc1))\n",
    "print(type(ecar1))\n",
    "print(type(car1))\n",
    "\n",
    "print(isinstance(truc1, Truck))\n",
    "print(isinstance(ecar1, ElectricCar))\n",
    "print(isinstance(car1, car))\n",
    "\n",
    "print(isinstance(truc1, car))\n",
    "print(isinstance(ecar1, car))\n"
   ]
  },
