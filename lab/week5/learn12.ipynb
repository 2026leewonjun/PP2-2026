   "source": [
    "class Base1:\n",
    "    def __init__(self, v1 = 10):\n",
    "        self.attr1 = v1\n",
    "\n",
    "    def display1(self):\n",
    "        print(f\"Base1: {self.attr1}\")\n",
    "\n",
    "    def display(self):\n",
    "        self.display1()\n",
    "\n",
    "class Base2:\n",
    "    def __init__(self, v2 = 20):\n",
    "        self.attr2 = v2\n",
    "\n",
    "    def display2(self):\n",
    "        print(f\"Base2: {self.attr2}\")\n",
    "\n",
    "    def display(self):\n",
    "        self.display2()\n",
    "\n",
    "class C(Base1, Base2):\n",
    "    def __init__(self, v1, v2, v3):\n",
    "        Base1.__init__(self, v1)\n",
    "        Base2.__init__(self, v2)\n",
    "        self.attr3 = v3\n",
    "\n",
    "    def print(self):\n",
    "        print(f\"{self.attr1}, {self.attr2}, {self.attr3}\")\n",
    "        self.display1()\n",
    "        self.display2()\n",
    "        self.display()\n",
    "        Base1.display(self)\n",
    "        Base2.display(self)\n",
    "\n",
    "def test():\n",
    "    c = C(v1=1, v2=2, v3=3)\n",
    "    c.print()\n",
    "\n",
    "    c2 = C(4,5,6)\n",
    "    c2.print()\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    test()"
   ]
